# ============================================================
# .env.example
# Copy to .env and edit values.  The app reads these via os.getenv()
# so they override backend/config.py without touching code.
# ============================================================

# Path to the CLT CSV data file
CSV_PATH=./data/sample_clt_data.csv

# Ollama settings
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Local Qdrant on-disk storage path
QDRANT_STORAGE_PATH=./qdrant_storage
